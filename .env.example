# EGS Elite Garage - Production Environment Variables Example
# Copy this file to .env for production deployment

# 1. Core Django Settings
DJANGO_PRODUCTION=True
DJANGO_SECRET_KEY=replace-with-a-secure-50-character-random-secret-key-here
ALLOWED_HOSTS=egs-garage.com,www.egs-garage.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://egs-garage.com,https://www.egs-garage.com

# 2. Database Configuration (Optional: defaults to SQLite if not provided)
# For PostgreSQL / Supabase / Render / Railway:
# DATABASE_URL=postgres://db_user:db_password@db_host:5432/db_name

# 3. Server Port Configuration
PORT=8000
